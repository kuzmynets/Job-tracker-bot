# Скопіюй у bot/.env і заповни. Файл .env не потрапляє в git.
TELEGRAM_TOKEN=          # від @BotFather
GEMINI_API_KEY=          # https://aistudio.google.com/apikey
SUPABASE_URL=            # https://xxxx.supabase.co
SUPABASE_KEY=            # secret / service_role ключ (Settings -> API Keys)

MY_STACK=Python, SQL, Git
ALLOWED_USER_IDS=        # твій Telegram ID, бот покаже його на /start
